---
import {
  ArrowRightIcon,
  ArrowSquareOutIcon,
  BookOpenIcon,
  CheckIcon,
  CopyIcon,
  DownloadIcon,
  GithubLogoIcon,
  ListIcon,
  LockIcon,
  MoonIcon,
  PlugsIcon,
  ShieldCheckIcon,
  SunIcon,
  TerminalIcon,
  XIcon,
  type IconProps,
} from '@phosphor-icons/react';
import type { ComponentType } from 'react';

export type IconName =
  | 'arrow-right'
  | 'arrow-out'
  | 'book'
  | 'check'
  | 'copy'
  | 'download'
  | 'github'
  | 'list'
  | 'lock'
  | 'moon'
  | 'plugs'
  | 'shield'
  | 'sun'
  | 'terminal'
  | 'x';

const MAP: Record<IconName, ComponentType<IconProps>> = {
  'arrow-right': ArrowRightIcon,
  'arrow-out': ArrowSquareOutIcon,
  book: BookOpenIcon,
  check: CheckIcon,
  copy: CopyIcon,
  download: DownloadIcon,
  github: GithubLogoIcon,
  list: ListIcon,
  lock: LockIcon,
  moon: MoonIcon,
  plugs: PlugsIcon,
  shield: ShieldCheckIcon,
  sun: SunIcon,
  terminal: TerminalIcon,
  x: XIcon,
};

interface Props {
  name: IconName;
  size?: number;
  class?: string;
}

const { name, size = 18, class: cls } = Astro.props;
const Cmp = MAP[name];
---

<Cmp size={size} weight="regular" className={cls} aria-hidden="true" />
