---
import Icon from './Icon.astro';

const COLUMNS = [
  {
    title: '文档',
    links: [
      { href: '/docs', label: '文档首页' },
      { href: '/docs/install', label: '安装' },
      { href: '/docs/getting-started', label: '入门指南' },
      { href: '/docs/caddyfile', label: 'Caddyfile' },
    ],
  },
  {
    title: 'HTTPS',
    links: [
      { href: '/docs/automatic-https', label: '自动 HTTPS' },
      { href: '/docs/json', label: 'JSON 配置' },
      { href: '/docs/api', label: '管理 API' },
      { href: '/docs/modules', label: '模块' },
    ],
  },
  {
    title: '社区',
    links: [
      { href: 'https://caddy.community', label: '官方论坛', external: true },
      { href: 'https://github.com/caddyserver/caddy', label: 'GitHub', external: true },
      { href: 'https://github.com/caddyserver/website', label: '贡献文档', external: true },
      { href: 'https://github.com/sponsors/mholt', label: '赞助作者', external: true },
    ],
  },
];
---

<footer class="band mt-0 bg-[var(--paper-2)]">
  <div class="shell py-14">
    <div class="grid gap-10 md:grid-cols-[1.4fr_2fr]">
      <div>
        <span class="text-[15px] font-semibold tracking-[-0.03em]">Caddy</span>
        <p class="mt-3 max-w-[42ch] text-[13.5px] leading-relaxed text-ink-2">
          一个默认启用 TLS 的可扩展服务器平台。用 Go 写成，编译到所有主流平台，运行时没有外部依赖。
        </p>
        <p class="mt-4 max-w-[42ch] text-[12.5px] leading-relaxed text-ink-3">
          本站是 Caddy 官方文档的中文整理，非官方站点。内容以
          <a href="https://caddyserver.com/docs/" class="text-brand underline decoration-1 underline-offset-2" target="_blank" rel="noreferrer">caddyserver.com/docs</a>
          为准。
        </p>
      </div>

      <div class="grid gap-8 sm:grid-cols-3">
        {
          COLUMNS.map((col) => (
            <div>
              <p class="mono mb-3">{col.title}</p>
              <ul class="flex flex-col gap-2.5">
                {col.links.map((link) => (
                  <li>
                    <a
                      href={link.href}
                      target={'external' in link && link.external ? '_blank' : undefined}
                      rel={'external' in link && link.external ? 'noreferrer' : undefined}
                      class="inline-flex items-center gap-1 text-[13.5px] text-ink-2 transition-colors hover:text-ink"
                    >
                      {link.label}
                      {'external' in link && link.external ? <Icon name="arrow-out" size={12} /> : null}
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          ))
        }
      </div>
    </div>

    <div class="mt-12 flex flex-col gap-2 border-t border-hair pt-6 text-[12.5px] text-ink-3 sm:flex-row sm:items-center sm:justify-between">
      <p>「Caddy」是 Stack Holdings GmbH 的注册商标。请称其为 Caddy，或 Caddy Web 服务器。</p>
      <p>Caddy 是 ZeroSSL 的一个项目。</p>
    </div>
  </div>
</footer>
