---
import '../styles/global.css';
import SiteFooter from '../components/SiteFooter.astro';
import SiteHeader from '../components/SiteHeader.astro';

interface Props {
  title: string;
  description: string;
  /** 站内路径，用于 canonical 与 og:url */
  path?: string;
  /** Open Graph 类型：文档页应传 'article' */
  ogType?: 'website' | 'article';
}

const { title, description, path = Astro.url.pathname, ogType = 'website' } = Astro.props;
const site = Astro.site ?? new URL('https://caddy.ndjp.net');
const canonical = new URL(path, site).href;
const fullTitle = path === '/' ? title : `${title} · Caddy 中文站`;
---

<!doctype html>
<html lang="zh-CN" data-theme="light" data-menu="closed">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="zh_CN" />
    <meta property="og:site_name" content="Caddy 中文站" />
    <meta name="twitter:card" content="summary" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/icons/favicon-32.png" type="image/png" sizes="32x32" />
    <link rel="icon" href="/icons/favicon-16.png" type="image/png" sizes="16x16" />
    <link rel="apple-touch-icon" href="/icons/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#fbfcfd" />
    <link
      rel="preload"
      href="/fonts/geist-geist-latin-wght-normal.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/geist-mono-geist-mono-latin-wght-normal.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <script is:inline>
      (function () {
        var t = 'light';
        try {
          t =
            localStorage.getItem('caddy-theme') ||
            (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
        } catch (e) {
          /* 忽略 */
        }
        document.documentElement.dataset.theme = t;
        document.documentElement.classList.add('js');
        var tc = document.querySelector('meta[name="theme-color"]');
        if (tc) tc.setAttribute('content', t === 'dark' ? '#0d1116' : '#fbfcfd');
      })();
    </script>
  </head>
  <body class="min-h-dvh">
    <SiteHeader />
    <main>
      <slot />
    </main>
    <SiteFooter />
    <script>
      import '../scripts/page';
    </script>
  </body>
</html>
