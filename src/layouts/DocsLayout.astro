---
import BaseLayout from './BaseLayout.astro';
import Icon from '../components/Icon.astro';
import { DOC_GROUPS, docHref, findDoc } from '../data/docs';

interface Props {
  slug: string;
}

const { slug } = Astro.props;
const found = findDoc(slug);
if (!found) throw new Error(`未知的文档页：${slug}`);

const { page, prev, next } = found;
const path = `/docs/${slug}`;
---

<BaseLayout title={page.title} description={page.lede} path={path} ogType="article">
  <div class="shell grid gap-10 py-10 md:py-14 lg:grid-cols-[196px_minmax(0,1fr)] lg:gap-14">
    <aside
      class="min-w-0 lg:sticky lg:top-24 lg:self-start"
      aria-label="文档目录"
    >
      <div class="-mx-5 flex snap-x snap-mandatory gap-1.5 overflow-x-auto px-5 pb-1 lg:mx-0 lg:flex-col lg:gap-6 lg:overflow-visible lg:px-0">
        {
          DOC_GROUPS.map((group) => (
            <div class="shrink-0 lg:w-full">
              <p class="mono mb-2 hidden lg:block">{group.title}</p>
              <ul class="flex gap-1.5 lg:flex-col lg:gap-px">
                {group.pages.map((item) => (
                  <li class="shrink-0 lg:shrink">
                    <a
                      href={docHref(item.slug)}
                      aria-current={item.slug === slug ? 'page' : undefined}
                      class:list={[
                        'block whitespace-nowrap rounded-ctl border px-3 py-1.5 text-[13px] transition-colors lg:whitespace-normal lg:rounded-none lg:border-0 lg:border-l-2 lg:py-1.5 lg:pl-3',
                        item.slug === slug
                          ? 'border-brand bg-brand-veil text-brand lg:border-l-brand lg:bg-transparent'
                          : 'border-hair text-ink-2 hover:border-hair-2 hover:text-ink lg:border-l-hair lg:bg-transparent',
                      ]}
                    >
                      {item.title}
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          ))
        }
      </div>
    </aside>

    <div class="min-w-0">
      <header>
        <p class="mono">{page.group}</p>
        <h1
          class="mt-2 text-[clamp(1.9rem,4vw,2.6rem)] font-semibold leading-[1.15] tracking-[-0.03em]"
        >
          {page.title}
        </h1>
        <p class="mt-3 max-w-[62ch] text-[15px] leading-[1.75] text-ink-2">{page.lede}</p>
      </header>

      <div class="docs-body mt-10">
        <slot />
      </div>

      {
        (prev || next) && (
          <nav class="mt-14 grid gap-4 border-t border-hair pt-6 sm:grid-cols-2" aria-label="上下篇">
            {prev ? (
              <a
                href={docHref(prev.slug)}
                class="group rounded-box border border-hair p-4 transition-colors hover:border-hair-2"
              >
                <span class="mono">上一篇</span>
                <span class="mt-1.5 flex items-center gap-1.5 text-[14px] text-ink">
                  {prev.title}
                  <Icon name="arrow-right" size={14} class="rotate-180" />
                </span>
              </a>
            ) : (
              <span />
            )}
            {next ? (
              <a
                href={docHref(next.slug)}
                class="group rounded-box border border-hair p-4 text-right transition-colors hover:border-hair-2 sm:col-start-2"
              >
                <span class="mono">下一篇</span>
                <span class="mt-1.5 flex items-center justify-end gap-1.5 text-[14px] text-ink">
                  <Icon name="arrow-right" size={14} />
                  {next.title}
                </span>
              </a>
            ) : null}
          </nav>
        )
      }
    </div>
  </div>
</BaseLayout>
