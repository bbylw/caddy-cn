---
import Icon from '../../components/Icon.astro';
import { DOC_GROUPS, DOC_PAGES, docHref } from '../../data/docs';
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout
  title="文档"
  description="Caddy 中文文档：安装、入门指南、快速上手、Caddyfile、自动 HTTPS、JSON 配置、管理 API、命令行与模块。"
  path="/docs"
>
  <section class="shell pb-20 pt-12 md:pt-16">
    <p class="mono">文档</p>
    <h1
      class="mt-3 max-w-[24ch] text-[clamp(2rem,5vw,3.2rem)] font-semibold leading-[1.1] tracking-[-0.035em]"
    >
      从安装到接管证书，一共四步
    </h1>
    <p class="mt-5 max-w-[58ch] text-[15.5px] leading-[1.75] text-ink-2">
      这里是 Caddy 官方文档的中文整理。建议所有用户，无论经验水平，都先读一遍入门指南，再去查参考。
    </p>

    <div class="mt-12 flex flex-col gap-12">
      {
        DOC_GROUPS.map((group) => (
          <div>
            <div class="flex items-baseline gap-4">
              <h2 class="text-[15px] font-semibold tracking-[-0.01em]">{group.title}</h2>
              <span class="h-px flex-1 bg-[var(--hair)]" />
              <span class="font-mono text-[11px] text-ink-3">
                {String(group.pages.length).padStart(2, '0')}
              </span>
            </div>
            <ul class="mt-4 grid gap-3 sm:grid-cols-2 lg:grid-cols-4">
              {group.pages.map((page) => (
                <li>
                  <a
                    href={docHref(page.slug)}
                    class="group flex h-full flex-col rounded-box border border-hair p-5 transition-colors hover:border-hair-2"
                  >
                    <span class="flex items-center justify-between gap-3">
                      <span class="text-[14.5px] font-medium text-ink">{page.title}</span>
                      <Icon
                        name="arrow-right"
                        size={14}
                        class="shrink-0 text-ink-3 transition-transform group-hover:translate-x-0.5"
                      />
                    </span>
                    <span class="mt-2 text-[13px] leading-relaxed text-ink-3">{page.lede}</span>
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>

    <p class="mt-14 border-t border-hair pt-6 text-[13px] text-ink-3">
      本站共 {DOC_PAGES.length} 篇，翻译自
      <a
        href="https://caddyserver.com/docs/"
        class="text-brand underline decoration-1 underline-offset-2"
        target="_blank"
        rel="noreferrer">caddyserver.com/docs</a
      >。更新可能滞后，遇到问题请以官方文档为准。
    </p>
  </section>
</BaseLayout>
